default_platform(:ios)

private_lane :sync_match do |options|
  repository = options.fetch(:type) == "development" ? "development" : "distribution"
  match(
    platform: options.fetch(:platform),
    type: options.fetch(:type),
    git_url: "git@github.com:Codetector1374/fastlane-#{repository}.git",
    app_identifier: "app.chahua.chat",
    team_id: "9422PL3GFR",
    readonly: options.fetch(:readonly, true)
  )
end

platform :ios do
  desc("Fetch iOS development signing assets without modifying Apple or the Match repository")
  lane :sync_development_signing do
    sync_match(
      platform: "ios",
      type: "development"
    )
  end

  desc("Fetch iOS App Store signing assets without modifying Apple or the Match repository")
  lane :sync_distribution_signing do
    sync_match(
      platform: "ios",
      type: "appstore"
    )
  end

  desc("Create or repair iOS development signing assets; intentionally mutable")
  lane :bootstrap_development_signing do
    sync_match(
      platform: "ios",
      type: "development",
      readonly: false
    )
  end

  desc("Create or repair iOS App Store signing assets; intentionally mutable")
  lane :bootstrap_distribution_signing do
    sync_match(
      platform: "ios",
      type: "appstore",
      readonly: false
    )
  end
end

