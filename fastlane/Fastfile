default_platform(:ios)

private_lane :sync_match do |options|
  repository = options.fetch(:type) == "development" ? "development" : "distribution"
  match(
    platform: options.fetch(:platform),
    type: options.fetch(:type),
    git_url: "git@github.com:Codetector1374/fastlane-#{repository}.git",
    app_identifier: "app.chahua.chat",
    team_id: "9422PL3GFR",
    readonly: options.fetch(:readonly, true)
  )
end

platform :ios do
  desc("Fetch iOS development signing assets without modifying Apple or the Match repository")
  lane :sync_development_signing do
    sync_match(
      platform: "ios",
      type: "development"
    )
  end

  desc("Fetch iOS App Store signing assets without modifying Apple or the Match repository")
  lane :sync_distribution_signing do
    sync_match(
      platform: "ios",
      type: "appstore"
    )
  end

  desc("Create or repair iOS development signing assets; intentionally mutable")
  lane :bootstrap_development_signing do
    sync_match(
      platform: "ios",
      type: "development",
      readonly: false
    )
  end

  desc("Create or repair iOS App Store signing assets; intentionally mutable")
  lane :bootstrap_distribution_signing do
    sync_match(
      platform: "ios",
      type: "appstore",
      readonly: false
    )
  end
end

platform :mac do
  desc("Fetch macOS development signing assets without modifying Apple or the Match repository")
  lane :sync_development_signing do
    sync_match(
      platform: "macos",
      type: "development"
    )
  end

  desc("Fetch macOS Developer ID signing assets without modifying Apple or the Match repository")
  lane :sync_distribution_signing do
    sync_match(
      platform: "macos",
      type: "developer_id"
    )
  end

  desc("Create or repair macOS development signing assets; intentionally mutable")
  lane :bootstrap_development_signing do
    sync_match(
      platform: "macos",
      type: "development",
      readonly: false
    )
  end

  desc("Create or repair macOS Developer ID signing assets; intentionally mutable")
  lane :bootstrap_distribution_signing do
    sync_match(
      platform: "macos",
      type: "developer_id",
      readonly: false
    )
  end
end

# Jenkins runs this only on the isolated macos-signing agent. Match remains read-only.
desc("Build the checked commit's App Store IPA and notarized Developer ID app ZIP")
lane :ci_artifacts do
  require "json"
  require "digest"

  root = File.expand_path("..", __dir__)
  output = File.join(root, "build", "artifacts")
  number = ENV.fetch("BUILD_NUMBER")
  UI.user_error!("BUILD_NUMBER must be a positive integer") unless number.match?(/\A[1-9]\d*\z/)
  version = number
  keychain = "chahua-ci-#{number}"
  FileUtils.mkdir_p(output)
  begin
    setup_ci(force: true, keychain_name: keychain, set_default_keychain: false, timeout: 7200)
    sync_match(platform: "ios", type: "appstore")
    build_app(
      project: File.join(root, "chahua-apple.xcodeproj"),
      scheme: "chahua-apple",
      configuration: "Release",
      destination: "generic/platform=iOS",
      archive_path: File.join(root, "build", "ios.xcarchive"),
      derived_data_path: File.join(root, "build", "DerivedData-ios"),
      output_directory: output,
      output_name: "Chahua.ipa",
      export_method: "app-store",
      export_options: {
        manageAppVersionAndBuildNumber: false,
        signingStyle: "manual",
        teamID: "9422PL3GFR",
        provisioningProfiles: { "app.chahua.chat" => "match AppStore app.chahua.chat" }
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{version} DEVELOPMENT_TEAM=9422PL3GFR",
      buildlog_path: File.join(root, "build", "logs"),
      xcodebuild_formatter: ""
    )

    sync_match(platform: "macos", type: "developer_id")
    archive = File.join(root, "build", "macos.xcarchive")
    sh(
      "xcodebuild", "archive",
      "-project", File.join(root, "chahua-apple.xcodeproj"),
      "-scheme", "chahua-apple",
      "-configuration", "Release",
      "-destination", "generic/platform=macOS",
      "-archivePath", archive,
      "-derivedDataPath", File.join(root, "build", "DerivedData-macos"),
      "CURRENT_PROJECT_VERSION=#{version}",
      "DEVELOPMENT_TEAM=9422PL3GFR",
      "ARCHS=arm64 x86_64",
      "ONLY_ACTIVE_ARCH=NO",
      "OTHER_CODE_SIGN_FLAGS=--timestamp",
      "ENABLE_HARDENED_RUNTIME=YES"
    )
    app = File.join(archive, "Products", "Applications", "Chahua.app")
    # The artifact is Developer ID-signed but intentionally unnotarized. The
    # manual macOS release job submits, staples, and publishes a selected ZIP.
    zip = File.join(output, "Chahua-macOS.zip")
    sh("codesign", "--verify", "--deep", "--strict", app)
    sh("ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", app, zip)

    artifacts = ["Chahua.ipa", "Chahua-macOS.zip"]
    File.write(File.join(output, "apple-artifact-metadata.json"), JSON.pretty_generate(
      buildNumber: number,
      bundleVersion: version,
      commitSha: ENV.fetch("GIT_COMMIT_SHA"),
      artifacts: artifacts.to_h { |name| [name, Digest::SHA256.file(File.join(output, name)).hexdigest] }
    ))
  ensure
    path = File.expand_path("~/Library/Keychains/#{keychain}-db")
    delete_keychain(name: keychain) if File.exist?(path)
  end
end
