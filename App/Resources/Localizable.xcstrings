    "Read receipts are mutual. If you hide yours from this friend, you won’t be able to see theirs." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read receipts are mutual. If you hide yours from this friend, you won’t be able to see theirs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已读回执是双向的。如果你向这位好友隐藏已读回执，你也将无法查看对方的已读回执。"
